datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum LessonKind {
  core
  weakness
  logic_gap
  time_complexity
}

enum LessonStatus {
  queued
  in_progress
  completed
}

enum ChatRole {
  user
  assistant
}

enum Verdict {
  correct
  incorrect
}

enum BugCategory {
  logic
  syntax
  runtime
  style
}

enum Severity {
  low
  medium
  high
}

// -----------------------------------------------------------------------------
// Models
// -----------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String?
  createdAt    DateTime @default(now())

  enrollments  Enrollment[]
  userConcepts UserConcept[]
  userLessons  UserLesson[]
  activityDays ActivityDay[]
  chatSessions ChatSession[]
  submissions  Submission[]
  mistakes     Mistake[]
  hintEvents   HintEvent[]

  @@map("users")
}

model Course {
  id       String @id @default(uuid())
  slug     String @unique
  title    String
  language String

  concepts     Concept[]
  lessons      Lesson[]
  enrollments  Enrollment[]
  chatSessions ChatSession[]

  @@map("courses")
}

model Concept {
  id       String @id @default(uuid())
  courseId String
  name     String
  position Int

  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons      Lesson[]
  userConcepts UserConcept[]

  @@map("concepts")
}

model Lesson {
  id         String     @id @default(uuid())
  courseId   String
  conceptId  String?
  title      String
  kind       LessonKind @default(core)
  estMinutes Int        @default(15)
  task       String?    @db.Text
  position   Int

  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  concept      Concept?      @relation(fields: [conceptId], references: [id], onDelete: Cascade)
  userLessons  UserLesson[]
  chatSessions ChatSession[]
  submissions  Submission[]
  hintEvents   HintEvent[]

  @@map("lessons")
}

model Enrollment {
  userId          String
  courseId        String
  diagnosticScore Decimal?
  currentFocus    String?
  enrolledAt      DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
  @@map("enrollments")
}

model UserConcept {
  userId    String
  conceptId String
  mastery   Decimal  @default(0)
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  concept Concept @relation(fields: [conceptId], references: [id], onDelete: Cascade)

  @@id([userId, conceptId])
  @@map("user_concepts")
}

model UserLesson {
  userId         String
  lessonId       String
  status         LessonStatus @default(queued)
  bestConfidence Decimal?
  completedAt    DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@map("user_lessons")
}

model ActivityDay {
  userId String
  day    DateTime @db.Date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("activity_days")
}

model ChatSession {
  id            String   @id @default(uuid())
  userId        String
  courseId      String
  lessonId      String?
  title         String?
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson      Lesson?       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  messages    ChatMessage[]
  submissions Submission[]
  hintEvents  HintEvent[]

  @@index([userId, lastMessageAt])
  @@map("chat_sessions")
}

model ChatMessage {
  id           String   @id @default(uuid())
  sessionId    String
  role         ChatRole
  content      String   @db.Text
  aiPayload    Json?
  codeSnapshot String?  @db.Text
  createdAt    DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}

model Submission {
  id          String   @id @default(uuid())
  userId      String
  lessonId    String?
  sessionId   String?
  language    String
  code        String   @db.Text
  stdout      String?  @db.Text
  stderr      String?  @db.Text
  testsPassed Int?
  testsTotal  Int?
  verdict     Verdict?
  confidence  Decimal?
  review      Json?
  createdAt   DateTime @default(now())

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson   Lesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  session  ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  mistakes Mistake[]

  @@index([userId, createdAt])
  @@map("submissions")
}

model BugPattern {
  id              String      @id @default(uuid())
  name            String      @unique
  category        BugCategory
  defaultSeverity Severity    @default(medium)

  mistakes Mistake[]

  @@map("bug_patterns")
}

model Mistake {
  id           String   @id @default(uuid())
  userId       String
  patternId    String
  submissionId String?
  line         Int?
  explanation  String?  @db.Text
  createdAt    DateTime @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  pattern    BugPattern  @relation(fields: [patternId], references: [id], onDelete: Cascade)
  submission Submission? @relation(fields: [submissionId], references: [id], onDelete: SetNull)

  @@index([userId, patternId])
  @@map("mistakes")
}

model HintEvent {
  id        String   @id @default(uuid())
  userId    String
  lessonId  String?
  sessionId String?
  level     Int
  createdAt DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson  Lesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  session ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, lessonId])
  @@map("hint_events")
}
