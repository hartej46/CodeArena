PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codearena?schema=public"

# AI Provider Configuration (Options: "google" | "ollama")
AI_PROVIDER=google

# Google GenAI (Gemini / Gemma API) Configuration
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-2.0-flash

# Local Ollama Configuration (e.g. gemma2:9b, gemma:4b)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:9b

# JWT Authentication Secret
JWT_SECRET=super_secret_jwt_key_change_in_production
